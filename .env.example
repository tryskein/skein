# Settings for docker-compose.production.yml. Copy to `.env`, fill in, chmod 600.
# `.env` holds every secret of the installation: never commit it, back it up.
#
# The guide for filling it in is INSTALL.md (written for an AI agent). Every
# service variable is described in the env-reference.md of its service:
#   projects/skein-api/docs/env-reference.md
#   projects/skein-web/docs/env-reference.md
#
# Rules:
#   - Lines below that start with `#` are optional and OFF. Remove the `#` to
#     use one; keep the others out. Do NOT write `NAME=` with an empty value to
#     mean "off" — in skein-api and skein-web an empty value is not the same as
#     an absent one.
#   - The uncommented lines with an empty value are REQUIRED; docker compose
#     refuses to start while they are empty.
#   - Variables that the compose file does not pass to a service (it lists them
#     explicitly) have no effect.

# ---------------------------------------------------------------------------
# Release
# ---------------------------------------------------------------------------

# The Skein release to run, for example 1.5.0. All three images are taken with
# the tag skein-<this value>. Pin it; do not use `latest` for a real installation.
SKEIN_VERSION=

# Registry that holds the images. Change only to run images from a mirror.
# SKEIN_REGISTRY=ghcr.io/tryskein

# ---------------------------------------------------------------------------
# Address and network
# ---------------------------------------------------------------------------

# Public address people and agents use, https, no trailing slash. REQUIRED.
# skein-api refuses to start unless it is https (ENVIRONMENT is production).
SKEIN_AGENT_PUBLIC_URL=
# Where links in emails and notifications point. Recommended always; required
# when mail is on. Normally the same value as above.
# SKEIN_APP_BASE_URL=

# Where skein-frontend listens on the host. The default is local only: a TLS
# reverse proxy on the same host forwards to it. Publish on all interfaces only
# if something else terminates TLS in front of it.
# SKEIN_BIND_ADDRESS=127.0.0.1
# SKEIN_HTTP_PORT=8080

# Subnet of the compose network, used when it clashes with one on your host.
# By default it is also the trusted-proxy range of skein-web.
# SKEIN_NETWORK_SUBNET=172.29.88.0/24
# Addresses whose X-Forwarded-* headers skein-web believes. Leave unset unless
# INSTALL.md tells you otherwise.
# SKEIN_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Secrets generated for this installation (INSTALL.md, section 5)
# ---------------------------------------------------------------------------

# Password of the database user. Hex only (it goes into a connection URL).
POSTGRES_PASSWORD=
# Shared by skein-api and skein-web, at least 16 characters.
SKEIN_INTERNAL_SECRET=

# ---------------------------------------------------------------------------
# Sign-in and the first administrator
# ---------------------------------------------------------------------------

# local (default), keycloak or hybrid.
# SKEIN_AUTH_MODE=local
# The first administrator, for local and hybrid. Used only while there are no
# users; remove these lines from this file afterwards (the email and the
# password together: an email without a password stops skein-api at start).
# SKEIN_INITIAL_ADMIN_EMAIL=
# SKEIN_INITIAL_ADMIN_PASSWORD=
# SKEIN_INITIAL_ADMIN_USERNAME=
# SKEIN_INITIAL_ADMIN_NAME=
# Single sign-on (keycloak and hybrid): see INSTALL.md, group B.
# SKEIN_AUTO_PROVISION=
# SKEIN_BOOTSTRAP_ADMIN_EMAIL=
# SKEIN_BREAKGLASS_ADMIN=
# SKEIN_OIDC_DEFAULT_ROLE=
# SKEIN_OAUTH_AUTHORIZATION_SERVERS=
# Authentication__Oidc__Authority=
# Authentication__Oidc__ClientId=
# Authentication__Oidc__ClientSecret=
# Authentication__Oidc__AllowedGroup=
# Authentication__LogoutRedirectUrl=

# ---------------------------------------------------------------------------
# Who may join, and how the installation is organised (INSTALL.md, group D)
# The defaults are the company preset; change only on purpose.
# ---------------------------------------------------------------------------

# SKEIN_INSTANCE_ADMIN_ENABLED=
# SKEIN_COMMON_SPACE_ENABLED=
# SKEIN_SIGNUP_ENABLED=
# SKEIN_SPACE_CREATION=
# SKEIN_PROJECT_DEFAULT_VISIBILITY=
# SKEIN_SPACE_MEMBER_LIMIT=
# SKEIN_SPACE_OWNED_LIMIT=
# SKEIN_SPACE_INVITES_PER_DAY=
# SKEIN_SPACE_INVITE_TTL=
# SKEIN_QUOTA_PERSONAL_PROJECTS=
# SKEIN_QUOTA_PERSONAL_STORAGE_BYTES=
# SKEIN_QUOTA_SPACE_PROJECTS=
# SKEIN_QUOTA_SPACE_STORAGE_BYTES=
# SKEIN_PROJECT_PREFIX_MIN_LENGTH=
# SKEIN_TURNSTILE_SITE_KEY=
# SKEIN_TURNSTILE_SECRET=
# SKEIN_TERMS_URL=
# SKEIN_PRIVACY_URL=
# Operator API (a SaaS operator only; its port is never published).
# SKEIN_OPERATOR_API_ENABLED=
# SKEIN_OPERATOR_API_KEY=

# ---------------------------------------------------------------------------
# Outgoing mail (INSTALL.md, group E). All of these are required once mail is on.
# ---------------------------------------------------------------------------

# SKEIN_EMAIL_ENABLED=true
# SKEIN_SMTP_HOST=
# SKEIN_SMTP_PORT=
# SKEIN_SMTP_TLS_MODE=
# SKEIN_SMTP_USERNAME=
# SKEIN_SMTP_PASSWORD=
# SKEIN_SMTP_FROM=
# How long a queued email is retried after temporary failures (default 24h):
# SKEIN_EMAIL_DELIVERY_TTL=

# ---------------------------------------------------------------------------
# Attachments (INSTALL.md, group F)
# ---------------------------------------------------------------------------

# Bundled Garage (the default): keep COMPOSE_PROFILES=garage, set the S3_*
# values and GARAGE_RPC_SECRET below, and make S3_PUBLIC_URL an https
# address that your TLS proxy forwards to 127.0.0.1:3900 (the Host header must
# reach the store unchanged).
# Bundled SeaweedFS or RustFS instead: set COMPOSE_PROFILES=seaweedfs (or rustfs),
# S3_URL set to http://seaweedfs:8333 (or http://rustfs:9000) and the same S3_* values;
# GARAGE_RPC_SECRET is not needed. One store profile at a time. INSTALL.md group F
# lists the limits of each.
# External S3: remove the COMPOSE_PROFILES line; set S3_URL, S3_ACCESS_KEY,
# S3_SECRET_KEY and, if needed, S3_BUCKET, S3_REGION and S3_USE_SSL to that service.
# No attachments: remove the COMPOSE_PROFILES line and leave all S3_* unset.
COMPOSE_PROFILES=garage
# S3_URL=http://garage:3900
# (seaweedfs: http://seaweedfs:8333, rustfs: http://rustfs:9000)
# S3_PUBLIC_URL=
# The access key and secret skein-api signs with; for the bundled Garage they are
# also the key Garage creates for itself at its first start (SeaweedFS and RustFS
# take the same pair as the key of their one user). Letters, digits, '.', '_' and '-'
# only; key id at least 8 characters, secret at least 16 (generate them as
# INSTALL.md section 5 says). Garage cannot re-create a key with another secret:
# to rotate there, pick a new S3_ACCESS_KEY.
# S3_REGION is also given to RustFS as its region.
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_USE_SSL=
# Browser origins for the bucket CORS rule; default: SKEIN_AGENT_PUBLIC_URL.
# Set it empty (S3_CORS_ALLOWED_ORIGINS=) to leave the bucket CORS alone; the rule
# skein-api sets REPLACES the whole CORS configuration of the bucket at every start.
# S3_CORS_ALLOWED_ORIGINS=
# Bundled Garage only: its cluster secret, 64 hex characters (openssl rand -hex 32).
# Required with COMPOSE_PROFILES=garage.
# GARAGE_RPC_SECRET=
# SKEIN_ATTACHMENT_MAX_SIZE_BYTES=
# Where the bundled store's S3 port is published on the host (any of the three
# stores; it is the only port they publish).
# SKEIN_S3_BIND_ADDRESS=127.0.0.1
# SKEIN_S3_PORT=3900

# ---------------------------------------------------------------------------
# Semantic search (INSTALL.md, group G). Needs an Ollama server you run.
# ---------------------------------------------------------------------------

# OLLAMA_URL=
# OLLAMA_MODEL=
# OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# Extras (INSTALL.md, group H)
# ---------------------------------------------------------------------------

# Web Push (browser notifications). Off while the keys are empty. Generate
# your own pair once, for example with `npx web-push generate-vapid-keys`,
# and keep the private key secret. Changing the pair later drops every
# existing browser subscription. SUBJECT is a contact, `mailto:` or `https://`.
# SKEIN_VAPID_PUBLIC=
# SKEIN_VAPID_PRIVATE=
# SKEIN_VAPID_SUBJECT=
# SKEIN_PWNED_PASSWORDS_ENABLED=
# SKEIN_INSTANCE_NAME=
# LOG_LEVEL=

# ---------------------------------------------------------------------------
# Other components (change only with a reason)
# ---------------------------------------------------------------------------

# Images of the infrastructure services. The defaults are pinned by digest.
# POSTGRES_IMAGE=
# GARAGE_IMAGE=
# SEAWEEDFS_IMAGE=
# RUSTFS_IMAGE=
